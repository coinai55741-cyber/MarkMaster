+// Embeddable avatar for games: one character on a canvas, play motions, set expressions,
+// and lip-sync to an <audio> element. Built as a single script (vite.embed.config.ts) that sets
+// window.VectorAvatar. Depends only on src/core and src/renderers/vector.
+import { VectorRenderer } from "../renderers/vector/vectorRenderer";
+import { parseMotion, samplePose, sampleFace, type Motion, type MotionJson } from "../core/motion";
+import { parsePose, emptyPose, type Pose, type PoseJson } from "../core/pose";
+import { composePose } from "../core/compose";
+import { DEFAULT_FACE, type FaceState, type Expression } from "../core/face";
+import { Blinker } from "../core/blink";
+import { mouthAt, type VisemeKey } from "../core/lipsync";
+
+const motionFiles = import.meta.glob("../../data/motions/**/*.json", { eager: true, import: "default" }) as Record<string, MotionJson>;
+const poseFiles = import.meta.glob("../../data/poses/*.json", { eager: true, import: "default" }) as Record<string, PoseJson>;
+
+export const MOTIONS: Record<string, Motion> = {};
+for (const j of Object.values(motionFiles)) if (!/^turn_/.test(j.name)) MOTIONS[j.name] = parseMotion(j);
+export const POSES: Record<string, Pose> = {};
+for (const j of Object.values(poseFiles)) POSES[j.name!] = parsePose(j);
+
+export interface AvatarOptions {
+  /** URL of the character's vector.json */
+  vectorUrl: string;
+  width: number;
+  height: number;
+  framing?: "body" | "face";
+  /** motion played when nothing else is playing (looped) */
+  idle?: string;
+}
+
+export class Avatar {
+  readonly renderer = new VectorRenderer();
+  private idle: string;
+  private motion = "";
+  private motionStart = 0;
+  private motionDone: (() => void) | null = null;
+  private now = 0;
+  private blinker = new Blinker({ seed: 3 });
+  private visemes: VisemeKey[] = [];
+  private audio: HTMLAudioElement | null = null;
+  private raf = 0;
+  face: FaceState = { ...DEFAULT_FACE };
+
+  private constructor(opts: AvatarOptions) { this.idle = opts.idle ?? "idle"; }
+
+  static async create(container: HTMLElement, opts: AvatarOptions): Promise<Avatar> {
+    const a = new Avatar(opts);
+    await a.renderer.init({
+      container, width: opts.width, height: opts.height, framing: opts.framing ?? "body",
+      character: { id: "embed", label: "embed", vector: { url: opts.vectorUrl } },
+    });
+    a.play(a.idle);
+    const loop = (t: number) => { a.frame(t / 1000); a.raf = requestAnimationFrame(loop); };
+    a.raf = requestAnimationFrame(loop);
+    return a;
+  }
+
+  get canvas() { return this.renderer.canvas; }
+  get motions() { return Object.keys(MOTIONS); }
+
+  /** Play a motion once (or loop it); resolves when a non-looping play ends. Falls back to idle. */
+  play(name: string, opts: { loop?: boolean } = {}): Promise<void> {
+    const m = MOTIONS[name];
+    this.motionDone?.();
+    this.motionDone = null;
+    this.motion = m ? name : "";
+    this.motionStart = this.now;
+    if (!m || opts.loop || name === this.idle) return Promise.resolve();
+    return new Promise((res) => { this.motionDone = res; });
+  }
+
+  setExpression(e: Expression) { this.face.expression = e; }
+  setYaw(deg: number) { this.face.yaw = deg; }
+
+  /** Lip-sync to an audio element (track from tools/lipsync/lipsync.py). Resolves when the audio ends. */
+  speak(audio: HTMLAudioElement, keys: VisemeKey[]): Promise<void> {
+    this.audio = audio;
+    this.visemes = keys;
+    return new Promise((res) => {
+      const end = () => { if (this.audio === audio) { this.audio = null; this.visemes = []; } res(); };
+      audio.addEventListener("ended", end, { once: true });
+      audio.addEventListener("pause", end, { once: true });
+      audio.addEventListener("error", end, { once: true });
+    });
+  }
+
+  private frame(time: number) {
+    this.now = time;
+    let m = MOTIONS[this.motion];
+    let t = time - this.motionStart;
+    if (m && !m.loop && t >= m.duration && this.motion !== this.idle) {
+      const done = this.motionDone;
+      this.motionDone = null;
+      this.motion = this.idle; this.motionStart = time; t = 0; m = MOTIONS[this.idle];
+      done?.();
+    }
+    const body = m ? samplePose(m, t) : POSES.attention ?? emptyPose();
+    const f = m ? sampleFace(m, t, {}, { ...this.face }) : { ...this.face };
+    // the game decides the expression; keep the motion's eyes only when it closes them
+    f.expression = this.face.expression;
+    if (f.eye === "open") f.eye = this.blinker.eyeAt(time);
+    const a = this.audio;
+    f.mouth = a && !a.paused && this.visemes.length ? mouthAt(this.visemes, a.currentTime) : "sil";
+    this.renderer.setPose(composePose(body, f));
+    this.renderer.setFace(f);
+    this.renderer.render(time);
+  }
+
+  dispose() { cancelAnimationFrame(this.raf); this.renderer.dispose(); }
+}
