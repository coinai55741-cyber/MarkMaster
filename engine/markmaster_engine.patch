     return out
 
 
+def hak_shapes(text):
+    """Hakka (Taiwan Hakka Pinyin, e.g. "ngiˊ vunˇ liangˊ vedˋ"): one shape per main vowel of each
+    syllable, a second shape for an off-glide (ai, au, oi, eu, iu, ui), and the lips close after a
+    final -m, -b or -p. A leading i/u before another vowel is a short glide and is skipped.
+    Syllabic m / n / ng (e.g. "ngˇ", "mˇ") get a small, half-closed "u"."""
+    out = []
+    for syl in re.findall(r"[a-zA-Z]+", text.lower()):
+        vowels = re.sub(r"[^aeiou]", "", syl)
+        if not vowels:
+            out.append("u" if re.fullmatch(r"(m|n|ng)", syl) else "sil")
+            continue
+        if len(vowels) > 1 and vowels[0] in "iu" and vowels[1] in "aeo":
+            vowels = vowels[1:]              # glide: ia, io, ie, ua, ue -> main vowel only
+        vowels = re.sub(r"(.)\1+", r"\1", vowels)  # "ii" (sii, zii) -> i
+        out.append(vowels[0])
+        if len(vowels) > 1:
+            out.append(vowels[1])             # off-glide: ai -> a, i
+        if re.search(r"(m|b|p)$", syl):
+            out.append("sil")
+    return out
+
